---
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Arabic script can't align inside monospace box art — diagram stays in English.
const diagram = `<span class="b">bridge phone (your SIM)</span>          <span class="b">your main phone</span>
┌───────────────────────┐        ┌───────────────────────┐
│  GSM network          │        │  SMS inbox + replies  │
│  SimTether Bridge     │ ────▶  │  incoming calls       │
│  (free app)           │        │  dial / answer / DTMF │
└──────────┬────────────┘        └──────────▲────────────┘
           │   <span class="a">Noise IK · X25519 · ChaCha20-Poly1305</span>   │
           └─────────── LAN / hotspot ──────┘
           └─────── optional ciphertext-only relay ─────┘`;
---

<Layout
  locale="ar"
  page="index"
  title="SimTether — شريحتك في هاتف رخيص. حياتك على هاتفك الحقيقي."
  description="يوجّه SimTether رسائل SMS وتحكم مكالمات GSM من شريحة مسجّلة في هاتف جسر منخفض التكلفة إلى هاتفك الرئيسي — مشفّرة من الطرف إلى الطرف، ومن دون خوادم."
>
  <header class="hero">
    <div class="container">
      <h1>شريحتك تبقى في البيت.<br /><em>ولا حاجة لأن تبقى أنت.</em></h1>
      <p>
        يحوّل SimTether هاتف أندرويد رخيصاً إلى جسر لشريحتك المسجّلة —
        تصلك رسائل SMS وتحكم مكالمات GSM على هاتفك الرئيسي، مشفّرة من
        الطرف إلى الطرف. لا حساب، لا إعلانات، ورسائلك لا تمرّ أبداً
        بخادم طرف ثالث.
      </p>
      <div class="badges">
        <span class="badge green">تشفير من الطرف إلى الطرف</span>
        <span class="badge">بدون حسابات</span>
        <span class="badge">لا إعلانات · لا متعقّبات</span>
        <span class="badge">يعمل بدون خوادمنا</span>
        <span class="badge">مفتوح المصدر</span>
      </div>
    </div>
  </header>

  <section id="how">
    <div class="container">
      <h2>كيف يعمل</h2>
      <p class="sub">تطبيقان، مسحة QR واحدة، وتعيش شريحتك في هاتف يمكن أن يبقى في الدرج.</p>
      <div class="cards">
        <div class="card">
          <span class="step">الخطوة 01</span>
          <h3>ضع شريحتك في هاتف الجسر</h3>
          <p>
            أي هاتف أندرويد رخيص يكفي. ثبّت <strong>SimTether Bridge</strong>،
            وصِله بشبكة منزلك، واتركه موصولاً بالشاحن — ليصبح جهازاً صغيراً
            مخصصاً لشريحتك.
          </p>
        </div>
        <div class="card">
          <span class="step">الخطوة 02</span>
          <h3>امسح مرة واحدة من هاتفك الحقيقي</h3>
          <p>
            ثبّت <strong>SimTether</strong> على هاتفك الرئيسي وامسح رمز QR
            الذي يعرضه الجسر. هذه المسحة الواحدة تثبّت مفاتيح التشفير —
            يكتمل الاقتران ويظل قائماً حتى تلغيه.
          </p>
        </div>
        <div class="card">
          <span class="step">الخطوة 03</span>
          <h3>الرسائل والمكالمات، أينما كنت</h3>
          <p>
            تصل رسائل SMS الواردة وأحداث المكالمات إلى هاتفك الرئيسي عبر
            الشبكة المحلية. أجب، ارفض، اتصل، أرسل DTMF — ويتولى الجسر
            العمليات التي تجري عبر شركة الاتصالات.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>المسار الذي تسلكه بياناتك</h2>
      <p class="sub">كل شيء بين الهاتفين مشفّر بـ Noise. الريلاي الاختياري لا يرى سوى نص مشفّر.</p>
      <div class="flow" set:html={diagram} />
      <div class="note">
        الوضع المحلي هو الافتراضي — لا يغادر الترافيك شبكتك أبداً. الوصول
        عن بُعد اختياري على الهاتفين، ويمكن أن يكون الريلاي لك بدلاً منا.
        الريلاي المستضاف لدينا خدمة بأفضل جهد؛ التطبيق يعمل بدونه، للأبد.
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>إصداران، بوسم صادق</h2>
      <p class="sub">نفس خط الأنابيب المشفّر — إصدار الروت يضيف الشيء الوحيد الذي يحجبه أندرويد.</p>
      <div class="cards">
        <div class="card">
          <h3>القياسي</h3>
          <p>
            توجيه كامل لرسائل SMS، وإشعارات المكالمات، والتحكم بالمكالمات —
            الرد، والرفض، والاتصال، وDTMF. يعمل على أي هاتف بأندرويد 8.0+
            من دون root. هذا هو الإصدار المتاح على Google Play.
          </p>
        </div>
        <div class="card">
          <h3>جسر بإصدار root <span class="badge" style="vertical-align:middle">GitHub فقط</span></h3>
          <p>
            إصدار تجريبي يمكنه أيضاً التقاط صوت مكالمات GSM المباشر وبثّه
            إلى هاتفك الرئيسي. يتطلب هاتف جسر بصلاحيات root، ويوزَّع عبر
            GitHub Releases فقط — ولا يسمح Google Play بذلك.
            <em>وهو قيد التطوير حالياً.</em>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>لمن هو</h2>
      <div class="prose">
        <ul>
          <li><strong>هواتف لا يمكن إبقاؤها مسجّلة محلياً أثناء السفر أو
              الإقامة في الخارج.</strong> في بعض الدول، يفقد الهاتف غير
              المسجّل محلياً الخدمة الخلوية بعد فترة سماح. اترك الشريحة
              المسجّلة — وهاتفها المسجّل — في المنزل، واحمل الهاتف الذي
              تريده.</li>
          <li><strong>شريحة ثانية من دون حمل هاتف ثانٍ في جيبك.</strong>
              رموز التحقق، ورسائل شركة الاتصالات، والمكالمات الواردة إلى رقم
              لا تريد حمل جهاز مخصص له.</li>
          <li><strong>المستخدمون المهتمون بالخصوصية</strong> الذين يريدون
              توجيه SMS من دون تسليم محتوى رسائلهم إلى خدمة سحابية.</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="container" style="text-align:center">
      <h2>احصل عليه</h2>
      <p class="sub">الجسر مجاني ومفتوح المصدر. تطبيق الهاتف الرئيسي شراء لمرة واحدة على Google Play.</p>
      <a class="btn" href={getRelativeLocaleUrl('ar', 'install')}>دليل التثبيت</a>
      <a class="btn secondary" href="https://github.com/">إصدارات GitHub</a>
    </div>
  </section>
</Layout>
