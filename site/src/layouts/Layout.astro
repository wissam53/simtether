---
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';

type Locale = 'en' | 'tr' | 'ar';
type Page = 'index' | 'install' | 'privacy' | 'security' | 'terms';

interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;

const LOCALES: Locale[] = ['en', 'tr', 'ar'];
const RTL: Locale[] = ['ar'];

// Pages that exist per non-English locale; missing pages fall back to English.
const LOCALE_PAGES: Partial<Record<Locale, Page[]>> = {
  tr: ['index', 'install', 'privacy', 'security', 'terms'],
  ar: ['index', 'install', 'privacy', 'security', 'terms'],
};

const ui = {
  en: {
    how: 'How it works',
    security: 'Security',
    install: 'Install',
    privacy: 'Privacy',
    terms: 'Terms',
    tagline: 'SimTether — SMS and call control, end-to-end encrypted.',
  },
  tr: {
    how: 'Nasıl çalışır',
    security: 'Güvenlik',
    install: 'Kurulum',
    privacy: 'Gizlilik',
    terms: 'Koşullar',
    tagline: 'SimTether — SMS ve arama kontrolü, uçtan uca şifreli.',
  },
  ar: {
    how: 'كيف يعمل',
    security: 'الأمان',
    install: 'التثبيت',
    privacy: 'الخصوصية',
    terms: 'الشروط',
    tagline: 'SimTether — رسائل SMS وتحكم المكالمات، مشفّرة من الطرف إلى الطرف.',
  },
}[locale];

const pathFor = (l: Locale, p: Page) =>
  p === 'index' ? getRelativeLocaleUrl(l) : getRelativeLocaleUrl(l, p);

const hasPage = (l: Locale, p: Page) =>
  l === 'en' || (LOCALE_PAGES[l]?.includes(p) ?? false);

// Internal link: current locale when the page exists there, else English.
const link = (p: Page) => pathFor(hasPage(locale, p) ? locale : 'en', p);

// Language switcher: same page when available, else that locale's index.
const switchLink = (l: Locale) => pathFor(l, hasPage(l, page) ? page : 'index');

const canonical = new URL(pathFor(locale, page), Astro.site);
const dir = RTL.includes(locale) ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.filter((l) => hasPage(l, page)).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(pathFor(l, page), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en', page), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav>
      <div class="container">
        <a class="logo" href={pathFor(locale, 'index')}>sim<span>tether</span></a>
        <div class="links">
          <a href={pathFor(locale, 'index') + '#how'}>{ui.how}</a>
          <a href={link('security')}>{ui.security}</a>
          <a href={link('install')}>{ui.install}</a>
          <a href={link('privacy')}>{ui.privacy}</a>
          {LOCALES.filter((l) => l !== locale).map((l) => (
            <a class="lang" href={switchLink(l)} hreflang={l}>{l.toUpperCase()}</a>
          ))}
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="container">
        <a href={link('privacy')}>{ui.privacy}</a>
        <a href={link('security')}>{ui.security}</a>
        <a href={link('install')}>{ui.install}</a>
        <a href={link('terms')}>{ui.terms}</a>
        <p style="margin-top:12px">{ui.tagline}</p>
      </div>
    </footer>
  </body>
</html>
