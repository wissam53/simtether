    <!-- Remote access (opt-in internet fallback via a splice relay) -->
    <string name="remote_access">Remote access</string>
    <string name="remote_client_hint">Reach your bridge over the internet when it isn’t on your local network — via a relay server you choose.</string>
    <string name="remote_bridge_hint">Make this phone reachable over the internet through a relay server, so your paired phone can find it away from home.</string>
    <string name="remote_consent_title">Enable remote access?</string>
    <string name="remote_consent_client">When your bridge isn’t on the local network, connections go through the relay over the internet.\n\nMessages and calls stay end-to-end encrypted — the relay forwards ciphertext only and cannot read anything. Whoever runs the relay can still see connection times and data amounts.\n\nThe hosted relay is a best-effort service and may be discontinued; local connections and self-hosted relays are unaffected.</string>
    <string name="remote_consent_bridge">This phone will connect out to the relay and stay reachable over the internet while remote access is on.\n\nEverything stays end-to-end encrypted — the relay forwards ciphertext only and cannot read anything. Whoever runs the relay can still see connection times and data amounts.\n\nThe hosted relay is a best-effort service and may be discontinued; local connections and self-hosted relays are unaffected.</string>
